# Copiar a .env y ajustar. .env no se versiona.

# Base de datos. En Supabase conviene usar el pooler en modo transacción para
# el runtime, y la conexión directa para migraciones.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/adrimarket

# Conexiones por instancia. En despliegue sin servidor el límite real es
# (instancias × este valor), así que se mantiene bajo a propósito.
DATABASE_POOL_MAX=5

# Dirección pública del sitio. Se usa para las URLs absolutas de canonical y
# hreflang; los buscadores ignoran hreflang si es relativo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pagos ---
# Con estas dos definidas se usa Stripe. Sin ellas, la pasarela local, que firma
# y verifica con el mismo mecanismo pero no cobra (ver src/modules/payments).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
LOCAL_WEBHOOK_SECRET=desarrollo_cambiar_en_produccion

# --- Correo ---
# Con estas dos definidas se envía por Resend. Sin ellas, el aviso se guarda
# renderizado en la bandeja para poder inspeccionarlo.
# RESEND_API_KEY=re_...
# MAIL_FROM=reservas@adrimarket.mx

# --- WhatsApp ---
# Con estas dos definidas se envía por la Cloud API de Meta. Sin ellas, el
# mensaje se arma igual —misma plantilla, mismos parámetros— y se guarda.
# Las plantillas tienen que estar aprobadas por Meta antes de poder enviarlas:
# ver src/modules/notifications/whatsapp.ts y docs/puesta-en-produccion.md §7.
# WHATSAPP_TOKEN=EAA...
# WHATSAPP_PHONE_ID=1234567890

# Secreto del latido del worker (POST /api/jobs/tick con cabecera x-job-secret).
# Sin el latido no expiran los apartados ni salen los avisos, y **falla en
# silencio**: por eso /api/health responde 503 si lleva más de diez minutos sin
# latir. El cron debe llamarlo cada minuto.
JOBS_SECRET=desarrollo_cambiar_en_produccion

# Dónde viven las fotos subidas. Fuera de public/ a propósito: Next resuelve
# public/ al compilar. En producción tiene que ser un volumen persistente.
# MEDIA_DIR=var/media

# Versión del aviso de privacidad que el huésped acepta en el checkout.
PRIVACY_VERSION=2026-08
