node_modules/
# Cualquier variante, no solo estas dos: `vercel env pull` escribe
# `.env.production.local` por omisión, y ahí viene la cadena de conexión a la
# base de producción. Con `.env` y `.env.local` sueltos, ese archivo entraba
# al repositorio sin que nadie lo notara.
.env
.env.*
!.env.example
.next/
dist/
*.log

# Baseline que genera drizzle-kit al introspectar: no se aplica nunca, las
# migraciones reales están escritas a mano en db/migrations.
src/db/generated/meta/
src/db/generated/*.sql
*.tsbuildinfo
var/media/*

# Capturas que dejan los recorridos en navegador al correr. Son evidencia de una
# corrida concreta, no del proyecto: se regeneran con `npm run test:e2e*`.
/*.png
.vercel
