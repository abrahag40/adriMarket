{
  "name": "adrimarket",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "./scripts/db.sh migrate",
    "db:seed": "./scripts/db.sh seed",
    "db:test": "./scripts/db.sh test",
    "db:bench": "./scripts/db.sh bench",
    "db:reset": "./scripts/db.sh reset",
    "db:pull": "drizzle-kit introspect && rm -rf src/db/generated/meta src/db/generated/*.sql && node scripts/patch-generated.mjs",
    "test:integration": "tsx --env-file-if-exists=.env --test src/**/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e.mjs",
    "test:e2e:admin": "node --env-file-if-exists=.env scripts/e2e-admin.mjs",
    "test:e2e:sme": "node --env-file-if-exists=.env scripts/e2e-sme.mjs",
    "test:e2e:publicar": "node --env-file-if-exists=.env scripts/e2e-publicar.mjs",
    "audit": "node --env-file-if-exists=.env scripts/audit.mjs",
    "audit:spacing": "node scripts/spacing-audit.mjs",
    "probar:correo": "tsx --env-file-if-exists=.env scripts/probar-correo.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.44.2",
    "next": "^15.5.23",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
